#pragma once
#include <string_view>

namespace util::info {
using namespace std::string_view_literals;
/** Short git commit hash from CMake configure_file (see CMakeLists.txt). */
constexpr std::string_view G_COMMIT_HASH= "@COMMIT_HASH@"sv;

/** Full project version (semver) from CMake project(VERSION ...). */
constexpr std::string_view G_PROJECT_VERSION= "@PROJECT_VERSION@"sv;

/** Project homepage URL from CMake project(HOMEPAGE_URL ...). */
constexpr std::string_view G_HOMEPAGE_URL= "@PROJECT_HOMEPAGE_URL@"sv;

constexpr std::string_view G_COPYRIGHT= "@PROJECT_DESCRIPTION@"sv;

/** Install-time data dir ${CMAKE_BINARY_DIR}/gen/data (see CMakeLists.txt). */
constexpr std::string_view G_DATA_DIR= "@G_DATA_DIR@"sv;

} // namespace util::info
